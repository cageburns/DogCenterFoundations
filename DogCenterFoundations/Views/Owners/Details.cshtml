@model DogCenterFoundations.Models.ViewModels.OwnerDetailsViewModel

@{
    ViewData["Title"] = "Owner Details";
}

<h1>Owner Details</h1>

<p>
    View the owner
</p>


<dl>
    <dt>First Name</dt>
    <dd>@Model.FirstName</dd>

    <dt>Last Name</dt>
    <dd>@Model.LastName</dd>

    <dt>Phone Number</dt>
    <dd>@Model.PhoneNumber</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Notes</dt>
    <dd>@Model.Notes</dd>
</dl>


<h3>Owned Dogs</h3>

@if (Model.Dogs.Any())
{
    <ul>
        @foreach (var dog in Model.Dogs)
        {
            <li>
                <a asp-controller="Dogs"
                   asp-action="Details"
                   asp-route-id="@dog.Id">
                    @dog.Name
                </a>

                <span>(@dog.Breed)</span>
            </li>
        }
    </ul>
}
else
{
    <p>No dogs registered.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">
        Edit
    </a>

    <a asp-action="Index">
        Back
    </a>
</div>