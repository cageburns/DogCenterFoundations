@model IEnumerable<DogCenterFoundations.Models.ViewModels.OwnerListViewModel>

@{
    ViewData["Title"] = "Owners";
}

<h1>Owners</h1>

<p class="text-muted">
	View and manage all individuals using DogCenter's services. You can add new owners, edit their information, and view the dogs they own.
</p>


@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}


<p>
    <a asp-controller="Owners" asp-action="Create" class="btn btn-primary">
        Add Owner
    </a>
</p>


<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone Number</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var owner in Model)
        {
            <tr>
                <td>@owner.FirstName</td>
                <td>@owner.LastName</td>
                <td>@owner.PhoneNumber</td>
                <td>@owner.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@owner.Id" class="me-2">Details</a>
                    <a asp-action="Edit" asp-route-id="@owner.Id">Edit</a>
                </td>
            </tr>
        }

        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No owners registered yet.
                </td>
            </tr>
        }
    </tbody>
</table>
