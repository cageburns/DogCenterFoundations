@model IEnumerable<DogCenterFoundations.Models.ViewModels.DogListViewModel>

@{
    ViewData["Title"] = "Dogs";
}

<h1>Dogs</h1>

<p class="text-muted">
    View and manage all dogs registered at DogCenter.
</p>


@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<p>
    <a asp-controller="Dogs" asp-action="Create" class="btn btn-primary">
        Add New Dog
    </a>
</p>


<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

    @foreach (var dog in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        @dog.Name

                        @if (dog.IsVip)
                        {
                            <span class="badge bg-warning text-dark">VIP</span>
                        }
                    </h5>

                    <p class="card-text">
                        <strong>Breed:</strong> @dog.Breed
                    </p>

                    <p class="card-text">
                        <strong>Birthday:</strong> @dog.Birthday.ToString("dd MMM yyyy")
                    </p>

                    <p class="card-text">
                        <strong>Owner:</strong> @dog.OwnerName
                    </p>


                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@dog.Id"
                           class="btn btn-primary me-2">
                            Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@dog.Id"
                           class="btn btn-secondary">
                            Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
