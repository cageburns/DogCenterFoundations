@model IEnumerable<DogCenterFoundations.Models.ViewModels.ServiceListViewModel>

@{
    ViewData["Title"] = "Services";
}

<h1>Find out more about our services by clicking on a category below:</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

@if (Model.Any())
{
    <div class="list-group">
        @foreach (var service in Model)
        {
            <a asp-action="Details"
               asp-route-id="@service.Id"
               class="list-group-item list-group-item-action">
                @service.ServiceName
            </a>
        }
    </div>
}
else
{
    <p>We're working on expanding our portfolio.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">
    All Categories
</a>
