@model DogCenterFoundations.Models.ViewModels.MedicalRecordCreateViewModel

@{
    ViewData["Title"] = "Create Medical Record";
}

<h1>Create Medical Record</h1>

<p class="text-muted">
    Enter the medical record information for @Model.DogName. Note that it is mandatory for the record to be created on the date it the treatment was performed. The record date is populated automatically. Delays in recording a medical visit will not be tolerated.
</p>


<form asp-action="Create" method="post">
    <input type="hidden" asp-for="DogId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RecordType" class="form-label"></label>
        <input asp-for="RecordType" class="form-control" />
        <span asp-validation-for="RecordType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NextDueDate" class="form-label"></label>
        <input asp-for="NextDueDate" type="date" class="form-control" />
        <span asp-validation-for="NextDueDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">
            Save
        </button>

        <a asp-controller="Dogs"
           asp-action="Details"
           asp-route-id="@Model.DogId"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
