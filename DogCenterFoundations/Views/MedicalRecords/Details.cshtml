@model DogCenterFoundations.Models.ViewModels.MedicalRecordDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} from {Model.Date:dd MMM yyyy}";
}

<h1>@Model.Name - @Model.Date.ToString("dd MMM yyyy")</h1>

<p class="text-muted">
	View the medical record information for the registered dog. Note that deleting a record is only permitted, if it was created in error. Medical records are considered permanent and it is not allowed to delete or backdate them.
</p>

<dl class="row">
    <dt class="col-sm-3">Record Type</dt>
    <dd class="col-sm-9">@Model.RecordType</dd>

    <dt class="col-sm-3">Dog</dt>
    <dd class="col-sm-9">@Model.DogName</dd>

    <dt class="col-sm-3">Brand</dt>
    <dd class="col-sm-9">@(Model.Brand ?? "")</dd>

    <dt class="col-sm-3">Next Due Date</dt>
    <dd class="col-sm-9">
        @(Model.NextDueDate?.ToString("dd MMM yyyy") ?? "")
    </dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(Model.Notes ?? "")</dd>
</dl>

<div class="mt-4 d-flex align-items-center flex-wrap gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        Edit
    </a>

    <a asp-controller="Dogs"
       asp-action="Details"
       asp-route-id="@Model.DogId"
       class="btn btn-secondary">
        Back to Dog Profile
    </a>
    
    <button type="button"
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#deleteRecordModal">
        Delete
    </button>

</div>

<div class="modal fade" id="deleteRecordModal" tabindex="-1"
     aria-labelledby="deleteRecordModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteRecordModalLabel">
                    Delete
                </h5>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong>@Model.Name</strong>?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">
                    <button type="submit" class="btn btn-danger">
                        Confirm
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>